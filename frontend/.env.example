# Apex OS terminal: where the browser reaches the FastAPI backend.
#
# Local: unset means http://localhost:8000, the port ./start.sh runs the backend on.
#   To override, copy this file to .env.local (git-ignored) and restart `npm run dev`.
# Production: set NEXT_PUBLIC_API_URL in Vercel → Project Settings → Environment Variables
#   to the Render service URL (for example https://apex-os-api.onrender.com), then redeploy.
#   Next.js inlines NEXT_PUBLIC_* values at build time, so a change needs a new build.
#   Add the Vercel origin to the backend's CORS_ORIGINS on Render, or the browser blocks the calls.
#
# If the API is slower than 2.5s, errors, or is unreachable, the terminal serves its local
# simulation desk instead. Ctrl+Shift+D pins that desk.
NEXT_PUBLIC_API_URL=http://localhost:8000
