# ==============================================================================
# APEX OS — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
# start.sh automatically sources .env and exports all keys to backend and frontend.

# ------------------------------------------------------------------------------
# 1. META MODELS & INFERENCE ENGINE (Meta Hackathon Track)
# ------------------------------------------------------------------------------
# Supports all standard hackathon conventions: META_API_KEY, LLAMA_API_KEY,
# META_LLAMA_API_KEY, or LLAMA_STACK_API_KEY.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Model Options:
#   - Meta Model API: muse-spark-1.3, muse-spark, muse-wonder, muse-image
#   - Baseten ($10K Open-Weights Bonus): meta-models/muse-spark-open-1026
#   - Modal / Open Weights: muse-spark-open, muse-glimmer
META_MODEL=muse-spark-1.3

# ------------------------------------------------------------------------------
# 2. AUDITOR & RAPID PRE-FILTER (Optional High-Throughput Tier)
# ------------------------------------------------------------------------------
# DeepSeek V3/R1 flash or high-speed extraction auditor
AUDITOR_API_KEY=
AUDITOR_BASE_URL=https://api.deepseek.com/v1
AUDITOR_MODEL=deepseek-flash
AUDITOR_TIMEOUT_SECONDS=6.0

# ------------------------------------------------------------------------------
# 3. CANVAS LMS INTEGRATION
# ------------------------------------------------------------------------------
# Canvas Personal Access Token (Account -> Settings -> New Access Token).
# If blank, Apex OS serves deterministic simulation desk instantly.
CANVAS_API_TOKEN=
CANVAS_API_URL=https://canvas.instructure.com
CANVAS_TIMEOUT_SECONDS=2.5

# ------------------------------------------------------------------------------
# 4. SUPABASE POSTGRESQL MIRROR (Optional Cloud Persistence)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# ------------------------------------------------------------------------------
# 5. PORTS & NETWORKING
# ------------------------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DEMO_MODE=false
